# ==========================================
# Rahul Auto Electricals — Environment Configuration
# ==========================================

# Database Connection (Supabase PostgreSQL / Local PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:[YOUR-SUPABASE-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret & Encryption
SECRET_KEY=generate-a-strong-random-key-for-production-min-32-chars

# CORS (Allowed Frontend Origins)
BACKEND_CORS_ORIGINS=["https://rahul-auto-electricals.vercel.app","http://localhost:5173"]

# Cloudinary Image Storage (Free Tier)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional SMTP Email Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# Initial Super Admin (Used by CLI setup command)
INITIAL_SUPERADMIN_EMAIL=admin@rahulautoelectricals.com
INITIAL_SUPERADMIN_PASSWORD=RahulSuperAdmin@2026!
INITIAL_SUPERADMIN_NAME=Rahul Super Admin

# Frontend API URL
VITE_API_BASE_URL=https://rahul-auto-electricals.onrender.com/api/v1

